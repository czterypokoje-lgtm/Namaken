# Copy to .env.local and fill in real values.

# Resend (https://resend.com) — sends lead-form submissions by email until
# the real CRM webhook is wired up (see src/app/actions/submitLead.ts).
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=info@autosleutelnamaken.nl

# Google Tag Manager container ID (create at tagmanager.google.com).
# Leave unset and the GTM script simply doesn't render — nothing breaks,
# but zero conversions are tracked. Once set, configure GA4, Google Ads
# conversion tracking, and Bing UET as Tags *inside* the GTM container
# (triggered by the dataLayer events already fired from src/lib/analytics.ts:
# tel_click, whatsapp_click, lead_form_submit) — no further code changes
# needed for any of those three.
NEXT_PUBLIC_GTM_ID=

# Search Console / Bing Webmaster Tools site-ownership verification codes
# (the "HTML tag" method — copy just the content="..." value, not the
# whole <meta> tag). Leave unset and the tag simply doesn't render.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
