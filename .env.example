# Copy to .env.local and fill in real values.

# Resend (https://resend.com) — sends lead-form submissions by email until
# the real CRM webhook is wired up (see src/app/actions/submitLead.ts).
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=info@autosleutelnamaken.nl

# Google Tag Manager container ID (pending — see plan doc "Pending inputs").
# Leave unset and the GTM script simply doesn't render.
NEXT_PUBLIC_GTM_ID=
