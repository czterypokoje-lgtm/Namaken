# Copy to .env.local for local development, and set the same keys in your
# hosting provider's environment variables for production.
# Everything here is optional: each feature switches itself off when its
# variable is unset, so the site builds and runs with none of them.

# ---------------------------------------------------------------------------
# Lead delivery
# ---------------------------------------------------------------------------

# Resend (https://resend.com) — e-mails each lead-form submission.
# The sending domain (autosleutelnamaken.nl) must be verified in Resend,
# otherwise the mail is rejected and the lead falls through to the webhook.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=info@autosleutelnamaken.nl

# Second, independent delivery channel for leads: any endpoint that accepts a
# JSON POST — a CRM, a Zapier/Make webhook, a Google Sheet relay. Set this and
# a lead survives a Resend outage or an unverified sending domain. The POST
# body contains the form fields plus the attribution fields (gclid, utm_*,
# landing_page, referrer).
LEAD_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <value>" so the endpoint can
# reject anything that is not from this site.
LEAD_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Analytics and conversion tracking
# ---------------------------------------------------------------------------

# GA4 measurement ID (Google Analytics > Admin > Data streams > Web).
# Looks like G-XXXXXXXXXX. Setting this alone is enough to start collecting
# sessions, traffic sources and the three conversion events the site fires
# (tel_click, whatsapp_click, lead_form_submit) — no GTM container needed.
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID (GTM-XXXXXXX). Optional and independent of
# GA4 above. The site pushes its conversion events to dataLayer either way, so
# an existing container keeps working.
NEXT_PUBLIC_GTM_ID=

# Google Ads conversion tracking. The ID looks like AW-123456789.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# One conversion label per action — the part AFTER the slash in a conversion's
# "send_to" value (AW-123456789/AbC-D_efGhIjK -> AbC-D_efGhIjK). Create three
# conversion actions in Google Ads, then paste their labels here. Any label
# left blank simply means that action is not reported to Ads.
NEXT_PUBLIC_ADS_LABEL_CALL=
NEXT_PUBLIC_ADS_LABEL_WHATSAPP=
NEXT_PUBLIC_ADS_LABEL_LEAD=

# Microsoft Clarity project ID (https://clarity.microsoft.com) — session
# recordings and heatmaps showing where visitors hesitate before calling.
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------
# Search engine verification
# ---------------------------------------------------------------------------

# Search Console / Bing Webmaster Tools site-ownership verification
# (the "HTML tag" method — copy just the content="..." value, not the whole
# <meta> tag). Leave unset and the tag simply doesn't render.
# NOTE: verify the https://www.autosleutelnamaken.nl property, since www is
# the canonical host. A Domain property in Search Console covers both.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
